# 开发环境 (dev)
NODE_ENV=development
PORT=3000

# 本地 PostgreSQL 连接串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/send_to_future?schema=public"

# PostgreSQL 容器初始化变量（供 docker-compose 使用）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=send_to_future
POSTGRES_PORT=5432

# LangChain / LLM 配置
OPENAI_API_KEY=your-dev-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 微信小程序登录配置（占位，请勿提交真实密钥）
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
JWT_SECRET=your-jwt-secret

# 接口守卫白名单（逗号分隔，支持 * 前缀通配；命中即免登录直接放行）
# /wechat/* 含登录/模拟登录；/pay/* 为微信支付回调（不带 JWT），均需放行
AUTH_WHITELIST=/wechat/*,/pay/*

# Redis（本地开发直连 localhost；docker-compose 内会自动覆盖为 redis 主机名）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 微信支付 V3 配置（占位，运营补充真实商户号与证书）=====
WECHAT_PAY_MCHID=your-mchid
WECHAT_PAY_SERIAL=your-cert-serial
WECHAT_PAY_PRIVATE_KEY=your-apiv3-private-key-pem
WECHAT_PAY_V3KEY=your-apiv3-key
WECHAT_PAY_NOTIFY_URL=http://localhost:3000/pay/notify

# 各渠道价格（元）：>0 为付费渠道（与小程序 priceMap 对齐）
WECHAT_PAY_PRICE_MAIL=9.9
WECHAT_PAY_PRICE_QQMAIL=0
WECHAT_PAY_PRICE_SMS=0.99
WECHAT_PAY_PRICE_UNBREAKABLE=19.9
