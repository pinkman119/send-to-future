# 开发环境 (dev)
NODE_ENV=development
PORT=3000

# 本地 PostgreSQL 连接串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/send_to_future?schema=public"

# PostgreSQL 容器初始化变量（供 docker-compose 使用）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=send_to_future
POSTGRES_PORT=5432

# LangChain / LLM 配置
OPENAI_API_KEY=your-dev-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 微信小程序登录配置（占位，请勿提交真实密钥）
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
JWT_SECRET=your-jwt-secret
