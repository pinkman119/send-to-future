{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Nest (one-click)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/main.js",
            "cwd": "${workspaceFolder}",
            "runtimeArgs": [
                "--inspect-brk=9229"
            ],
            "env": {
                "NODE_ENV": "development",
                "PORT": "3000"
            },
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Attach Nest (9229)",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "address": "localhost",
            "cwd": "${workspaceFolder}",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}