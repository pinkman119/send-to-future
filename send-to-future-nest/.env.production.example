# 生产环境 (prod)
NODE_ENV=production
PORT=3000

# 生产 PostgreSQL 连接串（替换为真实远程地址）
DATABASE_URL="postgresql://postgres:strong-password@your-prod-host:5432/send_to_future?schema=public"

# PostgreSQL 初始化变量（供 docker-compose 使用）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=send_to_future
POSTGRES_PORT=5432

# LangChain / LLM 配置
OPENAI_API_KEY=your-prod-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
